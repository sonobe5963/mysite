---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="container">
    <a href={`${base}`} class="logo-container">
      <img src={`${base}/images/ihs.png`} alt="IHS ロゴ" class="logo-image" />
      <span class="logo-text">園部悠太の備忘録</span>
    </a>
    
    <nav class="nav-links">
      <a href={`${base}/about`}>サイトマップ</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    padding: 0.8rem 0; /* タイトルが入るので少し詰めました */
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-container {
    display: flex;
    align-items: center;
    text-decoration: none;
    gap: 12px; /* ロゴ画像と文字の間の距離 */
  }

  .logo-image {
    height: 50px; /* 画像の大きさ */
    width: auto;
    display: block;
  }

  .logo-text {
    font-size: 1.6rem; /* タイトルの大きさ */
    font-weight: 700;
    color: #333;
    letter-spacing: 0.05em;
    /* 日本語の美しさを出すために、少しだけフォントを調整 */
    font-family: "M PLUS Rounded 1c", serif; 
  }

  .nav-links {
    display: flex;
    gap: 20px;
  }

  .nav-links a {
    text-decoration: none;
    color: black;
    font-size: 1.2rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #364e8b;
  }

  /* スマホ対応 */
  @media (max-width: 600px) {
    .container {
      flex-direction: column;
      gap: 12px;
    }
    .logo-image {
      height: 35px;
    }
    .logo-text {
      font-size: 1.1rem;
    }
  }
</style>