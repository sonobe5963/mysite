<header class="site-header">
  <div class="container">
    <a href="/" class="logo">天主公教備忘録</a>
    
    <nav class="nav-links">
      <a href="/about">案内</a>
      <a href="/bunken">文献</a>
      <a href="/opera">祈祷</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    background-color: #ffffff; /* 白背景で清潔感を */
    border-bottom: 1px solid #e0e0e0; /* 細い線一本だけ */
    padding: 1.5rem 0;
  }

  .container {
    max-width: 900px; /* 本文の幅に合わせる */
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.4rem;
    font-weight: 700;
    color: #333;
    text-decoration: none;
    letter-spacing: 0.05em; /* 文字間隔を少し広げて品格を出す */
  }

  .nav-links {
    display: flex;
    gap: 20px; /* リンク同士の間隔 */
  }

  .nav-links a {
    text-decoration: none;
    color: #666;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: #364e8b; /* 以前使っていた紺色をアクセントに */
  }

  /* スマホ対応：画面が狭いときは縦に並べるか、中央寄せにする */
  @media (max-width: 600px) {
    .container {
      flex-direction: column;
      gap: 15px;
    }
    .nav-links {
      gap: 15px;
    }
  }
</style>