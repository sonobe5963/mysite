---
import Header from '../components/Header.astro';
const { title } = Astro.props; // 各ページからタイトルを受け取れるようにする
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 天主公教備忘録</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <Header />
    <main class="content-container">
      <article class="document-body">
        <slot />
      </article>
    </main>

    <footer style="text-align: center; padding: 20px;">
      <p>&copy; 2026 天主公教備忘録</p>
    </footer>
  </body>
</html>

<style>
    .content-container {
      max-width: 800px; /* 視線が泳がない程度の幅 */
      margin: 40px auto;
      padding: 0 20px;
    }

    .document-body {
      line-height: 1.8; /* 行間を広めに */
      color: #333;
    }

    /* 見出しの装飾：落ち着いた紺色の線を下に引く */
    .document-body h1 {
      font-size: 2rem;
      border-bottom: 2px solid #364e8b;
      padding-bottom: 0.5rem;
      margin-bottom: 2rem;
    }

    .document-body h2 {
      font-size: 1.5rem;
      margin-top: 3rem;
      border-left: 4px solid #364e8b;
      padding-left: 1rem;
    }
</style>